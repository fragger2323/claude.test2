{
  "name": "agency-intelligence-os",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first business development OS for a web studio: multi-source lead discovery, live website analysis, service matching, audits, outreach drafts and CRM.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/jobs/worker.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/server/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:pg:schema": "node scripts/gen-postgres-schema.mjs",
    "db:pg:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:pg:deploy": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:pg": "node scripts/test-pg.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@prisma/client": "6.19.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "libphonenumber-js": "1.13.14",
    "papaparse": "5.7.0",
    "pino": "9.14.0",
    "playwright": "1.56.1",
    "prisma": "6.19.3",
    "tldts": "^7.0.17",
    "undici": "^7.16.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "22.20.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "lucide-react": "0.577.0",
    "pino-pretty": "13.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.4",
    "tailwindcss": "4.1.18",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
