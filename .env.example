# ─────────────────────────────────────────────────────────────
# Agency Intelligence OS — environment configuration
# Copy to .env (or run `npm run setup`). NEVER commit .env.
# All provider keys are optional: the app works with whatever is configured.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# SQLite for local dev (path is relative to prisma/schema.prisma). For production use PostgreSQL:
# DATABASE_URL=postgresql://aios:password@localhost:5432/aios?schema=public
DATABASE_URL=file:../data/dev.db
HOST=127.0.0.1
PORT=4000
# Public URL (used for cookie security + origin checks), e.g. https://leads.mystudio.com
APP_URL=
# 32-byte key (64 hex chars) used to encrypt API keys entered in the UI. `npm run setup` generates it.
APP_ENCRYPTION_KEY=
# Required in production to create the first account (enter it on the setup screen).
SETUP_TOKEN=
SESSION_TTL_HOURS=336
DATA_DIR=./data
LOG_LEVEL=info
LOG_PRETTY=false

# ── Worker / jobs ──
# true = run the job worker inside the API process (simplest single-box setup)
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=2
SCHEDULER_ENABLED=true

# ── Website analysis ──
BROWSER_POOL_SIZE=2
ANALYSIS_CONCURRENCY=2
ANALYSIS_MAX_PAGES=4
ANALYSIS_TIMEOUT_MS=45000
REANALYZE_AFTER_DAYS=14
RESPECT_ROBOTS_TXT=true
# Optional custom Chromium binary (otherwise Playwright's bundled Chromium is used)
BROWSER_EXECUTABLE_PATH=
# Only for local tests against 127.0.0.x fixture sites. Never enable in production.
ALLOW_PRIVATE_NETWORK_TARGETS=false
LIGHTHOUSE_ENABLED=false

# ── Cost control ──
MAX_PROVIDER_CALLS_PER_JOB=300
JOB_MAX_LEADS=1000

# ── Business / places sources (optional) ──
# Google Places API (New): https://console.cloud.google.com/ → enable "Places API (New)"
GOOGLE_PLACES_API_KEY=
# Foursquare Places: https://foursquare.com/developers/ → Service API key
FOURSQUARE_API_KEY=
FOURSQUARE_API_VERSION=2025-06-17
# Yelp Places (Fusion): https://docs.developer.yelp.com/
YELP_API_KEY=
# OpenStreetMap (Nominatim + Overpass) — free, no key. Identify yourself per the usage policy:
OSM_ENABLED=true
OSM_CONTACT_EMAIL=

# ── Web discovery (optional) ──
# Brave Search API: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Google Programmable Search (Custom Search JSON API)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ── AI (optional; technical analysis works without it) ──
# auto = use Anthropic when ANTHROPIC_API_KEY is set; none = never call AI
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (leave empty for the model default; lower = cheaper)
AI_EFFORT=
AI_MONTHLY_TOKEN_BUDGET=3000000
AI_VISUAL_ANALYSIS=true
AI_SERVER_FALLBACKS=true
