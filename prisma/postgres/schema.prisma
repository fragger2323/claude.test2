// GENERATED by scripts/gen-postgres-schema.mjs from prisma/schema.prisma — do not edit by hand.
// Agency Intelligence OS — database schema.
//
// This file is the single source of truth. It targets SQLite for local development;
// `npm run db:pg:schema` generates prisma/postgres/schema.prisma for production PostgreSQL.
// Portability rules: no native enums (string unions validated in TypeScript), JSON via `Json`,
// no raw SQL in business logic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Auth ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
}

// ───────────────────────── My Business ─────────────────────────

/// Singleton (id = "default"): the studio's own profile used during qualification.
model BusinessProfile {
  id                     String    @id @default("default")
  studioName             String?
  senderName             String?
  senderRole             String?
  website                String?
  currency               String    @default("EUR")
  minProjectSize         Int?
  targetClientProfile    String?
  communicationLanguage  String    @default("en")
  preferredIndustries    Json
  excludedIndustries     Json
  preferredCountries     Json
  preferredCities        Json
  preferredTechnologies  Json
  disallowedProjectTypes Json
  portfolioUrls          Json
  scoringWeights         Json?
  onboardingCompletedAt  DateTime?
  updatedAt              DateTime  @updatedAt
}

model Service {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  priceMin        Int?
  priceMax        Int?
  currency        String           @default("EUR")
  targetProfile   String?
  /// ProblemTag[] this service solves
  problemTypes    Json
  /// 0..100 minimum service-fit score to recommend
  minimumFit      Int              @default(40)
  /// ExclusionRule[] — cases where the service must not be recommended
  excludedCases   Json
  technologies    Json
  /// "small" | "medium" | "large" — used to guard big-ticket recommendations
  projectSize     String           @default("medium")
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]
}

model PortfolioProject {
  id           String   @id @default(cuid())
  name         String
  url          String?
  industry     String?
  /// string[] e.g. ["WordPress"]
  technologies Json
  /// string[] e.g. ["minimal", "luxury"]
  styles       Json
  /// service slugs
  services     Json
  caseStudy    String?
  /// Real, user-provided results only.
  results      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────── Sources / providers ───────────────────────

/// Provider registry entry + health (circuit breaker state).
model Source {
  id                  String    @id
  name                String
  category            String
  enabled             Boolean   @default(true)
  config              Json
  totalCalls          Int       @default(0)
  totalFailures       Int       @default(0)
  consecutiveFailures Int       @default(0)
  avgLatencyMs        Int       @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  circuitOpenUntil    DateTime?
  updatedAt           DateTime  @updatedAt
}

/// API keys entered through the UI, encrypted with AES-256-GCM (APP_ENCRYPTION_KEY).
model SecretSetting {
  name       String   @id
  ciphertext String
  last4      String
  updatedAt  DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ProviderUsage {
  id           String @id @default(cuid())
  provider     String
  day          String
  calls        Int    @default(0)
  failures     Int    @default(0)
  cacheHits    Int    @default(0)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)

  @@unique([provider, day])
}

model CacheEntry {
  key       String   @id
  namespace String
  value     Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([namespace])
  @@index([expiresAt])
}

// ───────────────────────── Campaigns & jobs ─────────────────────────

model Campaign {
  id            String         @id @default(cuid())
  name          String
  industry      String
  location      String
  country       String
  serviceSlug   String?
  targetLeads   Int            @default(100)
  status        String         @default("active")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  searchJobs    SearchJob[]
  campaignLeads CampaignLead[]
  leads         Lead[]
  savedSearches SavedSearch[]
}

model SavedSearch {
  id           String      @id @default(cuid())
  name         String
  /// SearchParams
  params       Json
  /// provider ids to use (empty = all enabled)
  sourceConfig Json
  /// null | "daily" — future scheduler hook, never sends messages
  schedule     String?
  scheduleHour Int?
  campaignId   String?
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  searchJobs   SearchJob[]
}

model SearchJob {
  id            String         @id @default(cuid())
  campaignId    String?
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  savedSearchId String?
  savedSearch   SavedSearch?   @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  /// SearchParams
  params        Json
  status        String         @default("queued")
  stage         String         @default("queued")
  /// "run" | "pause" | "cancel" — cooperative control flag read by the pipeline
  control       String         @default("run")
  trigger       String         @default("manual")
  progress      Json
  counts        Json
  sourcesUsed   Json
  strategyLog   Json
  error         String?
  createdAt     DateTime       @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime       @updatedAt
  queries       SearchQuery[]
  sourceRecords SourceRecord[]
  campaignLeads CampaignLead[]
  analyses      Analysis[]

  @@index([createdAt])
}

model SearchQuery {
  id              String     @id @default(cuid())
  searchJobId     String
  searchJob       SearchJob  @relation(fields: [searchJobId], references: [id], onDelete: Cascade)
  text            String
  /// bare niche term used in the query (e.g. "dentysta")
  term            String     @default("")
  language        String
  segment         String?
  strategy        String
  template        String
  intent          String     @default("places")
  providerIds     Json
  status          String     @default("pending")
  resultsCount    Int        @default(0)
  newRecordsCount Int        @default(0)
  error           String?
  executedAt      DateTime?
  createdAt       DateTime   @default(now())
  hits            QueryHit[]

  @@index([searchJobId])
  @@index([template])
}

model QueryHit {
  id             String       @id @default(cuid())
  searchQueryId  String
  searchQuery    SearchQuery  @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  provider       String
  rank           Int
  createdAt      DateTime     @default(now())

  @@unique([searchQueryId, sourceRecordId, provider])
  @@index([sourceRecordId])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("queued")
  payload     Json
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedBy    String?
  lockedUntil DateTime?
  lastError   String?
  result      Json?
  searchJobId String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, runAfter])
  @@index([searchJobId])
}

// ───────────────────────── Companies & provenance ─────────────────────────

model Company {
  id               String         @id @default(cuid())
  name             String
  normalizedName   String
  legalName        String?
  industry         String?
  categories       Json
  primaryDomain    String?
  phoneE164        String?
  address          String?
  city             String?
  postalCode       String?
  country          String?
  lat              Float?
  lng              Float?
  /// "operational" | "closed_temporarily" | "closed_permanently" | "unknown"
  businessStatus   String         @default("unknown")
  rating           Float?
  ratingCount      Int?
  priceLevel       Int?
  /// provider ids that contributed
  sources          Json
  /// Discrepancy[] — conflicting values across sources, never hidden
  discrepancies    Json
  isExistingClient Boolean        @default(false)
  doNotContact     Boolean        @default(false)
  firstSeenAt      DateTime       @default(now())
  lastSeenAt       DateTime       @default(now())
  lastVerifiedAt   DateTime?
  sourceTimestamp  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  locations        Location[]
  website          Website?
  contacts         Contact[]
  sourceRecords    SourceRecord[]
  lead             Lead?

  @@index([primaryDomain])
  @@index([phoneE164])
  @@index([normalizedName])
  @@index([city])
}

model Location {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label       String?
  address     String?
  street      String?
  city        String?
  postalCode  String?
  region      String?
  country     String?
  lat         Float?
  lng         Float?
  phoneE164   String?
  sources     Json
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([companyId])
}

model SourceRecord {
  id                 String     @id @default(cuid())
  provider           String
  providerRecordId   String
  searchJobId        String?
  searchJob          SearchJob? @relation(fields: [searchJobId], references: [id], onDelete: SetNull)
  companyId          String?
  company            Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name               String?
  normalizedName     String?
  categories         Json
  address            String?
  street             String?
  city               String?
  postalCode         String?
  region             String?
  country            String?
  lat                Float?
  lng                Float?
  phone              String?
  phoneE164          String?
  website            String?
  websiteDomain      String?
  email              String?
  /// provider profile page (e.g. a Yelp listing) — never treated as the official website
  profileUrl         String?
  businessStatus     String?
  rating             Float?
  ratingCount        Int?
  priceLevel         Int?
  payload            Json?
  fetchedAt          DateTime   @default(now())
  /// when the source itself last changed this record (e.g. OSM last edit), if it says so
  sourceUpdatedAt    DateTime?
  firstSeenAt        DateTime   @default(now())
  lastSeenAt         DateTime   @default(now())
  retentionExpiresAt DateTime?
  purgedAt           DateTime?
  hits               QueryHit[]

  @@unique([provider, providerRecordId])
  @@index([companyId])
  @@index([searchJobId])
  @@index([websiteDomain])
  @@index([phoneE164])
  @@index([retentionExpiresAt])
}

model Website {
  id              String     @id @default(cuid())
  companyId       String     @unique
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url             String?
  domain          String?
  finalUrl        String?
  /// "found" | "not_found" | "unreachable"
  status          String     @default("found")
  confidence      String     @default("low")
  discoverySource String?
  /// Candidates checked, with verdicts — explains "No official website found"
  discoveryLog    Json
  notFoundReason  String?
  httpStatus      Int?
  platform        String?
  lastCheckedAt   DateTime?
  lastAnalyzedAt  DateTime?
  firstSeenAt     DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  analyses        Analysis[]

  @@index([domain])
}

model Analysis {
  id              String       @id @default(cuid())
  websiteId       String
  website         Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  companyId       String
  searchJobId     String?
  searchJob       SearchJob?   @relation(fields: [searchJobId], references: [id], onDelete: SetNull)
  analyzerVersion Int          @default(1)
  /// "running" | "completed" | "partial" | "failed" | "unreachable"
  status          String       @default("running")
  url             String
  finalUrl        String?
  httpStatus      Int?
  redirectChain   Json
  pagesVisited    Json
  metrics         Json
  tech            Json
  summary         Json
  contactsFound   Json
  errors          Json
  /// "not_run" | "completed" | "failed" | "skipped_no_provider" | "skipped_budget" | "skipped_disabled"
  aiStatus        String       @default("not_run")
  aiModel         String?
  /// null = Lighthouse was not run (never invented)
  lighthouse      Json?
  fingerprint     String?
  contentHash     String?
  diff            Json?
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  findings        Finding[]
  screenshots     Screenshot[]

  @@index([websiteId, startedAt])
  @@index([companyId])
}

model Finding {
  id          String   @id @default(cuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  companyId   String
  code        String
  category    String
  /// "negative" | "positive" | "neutral"
  polarity    String   @default("negative")
  severity    String   @default("low")
  /// "observed" | "measured" | "ai_observation"
  kind        String   @default("observed")
  /// "code" | "ai" | "lighthouse"
  source      String   @default("code")
  title       String
  detail      String
  evidence    Json
  pageUrl     String?
  viewport    String?
  confidence  String   @default("high")
  problemTags Json
  detectedAt  DateTime @default(now())

  @@index([analysisId])
  @@index([companyId])
  @@index([code])
}

model Screenshot {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  pageUrl    String
  viewport   String
  kind       String   @default("viewport")
  path       String
  width      Int
  height     Int
  bytes      Int
  sha256     String
  takenAt    DateTime @default(now())

  @@index([analysisId])
}

model Contact {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// "email" | "phone" | "contact_form" | "social" | "address" | "website"
  type            String
  subtype         String?
  value           String
  normalizedValue String
  label           String?
  personName      String?
  role            String?
  source          String
  sourceUrl       String?
  /// "verified" | "probable" | "unverified"
  status          String    @default("unverified")
  confidence      String    @default("low")
  isRoleBased     Boolean   @default(false)
  isPersonal      Boolean   @default(false)
  /// JSON list of all sources that reported this value
  sightings       Json
  firstSeenAt     DateTime  @default(now())
  lastVerifiedAt  DateTime  @default(now())
  expiredAt       DateTime?

  @@unique([companyId, type, normalizedValue])
  @@index([companyId])
}

// ───────────────────────────── CRM ─────────────────────────────

model Lead {
  id                   String           @id @default(cuid())
  companyId            String           @unique
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId           String?
  campaign             Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  stage                String           @default("new")
  stageChangedAt       DateTime         @default(now())
  /// "very_high" | "high" | "medium" | "low" | "excluded" | "insufficient_data"
  priority             String?
  priorityRank         Int              @default(0)
  leadFit              Int?
  websiteNeed          Int?
  serviceFit           Int?
  contactability       Int?
  freshness            Int?
  components           Json?
  priorityReasons      Json
  salesPotential       Json?
  decision             Json?
  primaryServiceSlug   String?
  secondaryServiceSlug String?
  mainOpportunity      String?
  contactAvailability  String?
  portfolioMatch       Json?
  excludedReason       String?
  qualifiedAt          DateTime?
  lastScoredAt         DateTime?
  contactedAt          DateTime?
  /// feature snapshot captured when the lead was contacted — used for learning without leakage
  contactedFeatures    Json?
  nextFollowUpAt       DateTime?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  recommendations      Recommendation[]
  audits               Audit[]
  outreach             Outreach[]
  activities           Activity[]
  followUps            FollowUp[]
  outcomes             Outcome[]
  campaignLeads        CampaignLead[]

  @@index([stage])
  @@index([priorityRank])
  @@index([campaignId])
}

model CampaignLead {
  id             String     @id @default(cuid())
  campaignId     String
  campaign       Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  searchJobId    String?
  searchJob      SearchJob? @relation(fields: [searchJobId], references: [id], onDelete: SetNull)
  excludedReason String?
  addedAt        DateTime   @default(now())

  @@unique([campaignId, leadId])
  @@index([searchJobId])
}

model Recommendation {
  id               String   @id @default(cuid())
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceSlug      String
  /// "primary" | "secondary" | "do_not_recommend" | "candidate"
  kind             String
  fitScore         Int
  reasons          Json
  exclusionReasons Json
  createdAt        DateTime @default(now())

  @@index([leadId])
}

model Audit {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  analysisId String?
  generator  String   @default("template")
  aiModel    String?
  status     String   @default("draft")
  content    Json
  markdown   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId])
}

model Outreach {
  id                 String    @id @default(cuid())
  leadId             String
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel            String    @default("email")
  tone               String    @default("professional")
  language           String    @default("en")
  subject            String?
  body               String
  generator          String    @default("template")
  aiModel            String?
  usedFindingIds     Json
  portfolioProjectId String?
  lintWarnings       Json
  /// "draft" | "approved" | "sent_manually" | "discarded"
  status             String    @default("draft")
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadId])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  summary   String
  data      Json?
  actor     String   @default("user")
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model FollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  note        String?
  channel     String?
  status      String    @default("pending")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, dueAt])
  @@index([leadId])
}

model Outcome {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// "replied" | "no_reply" | "not_interested" | "wrong_fit" | "meeting" | "proposal" | "won" | "lost"
  type        String
  dealValue   Int?
  serviceSlug String?
  notes       String?
  features    Json?
  recordedAt  DateTime @default(now())

  @@index([leadId])
  @@index([type])
}

model ModelRun {
  id           String   @id @default(cuid())
  /// "reply" | "won"
  target       String
  version      Int
  /// "trained" | "insufficient_data" | "failed"
  status       String
  active       Boolean  @default(false)
  sampleSize   Int
  positives    Int
  metrics      Json
  coefficients Json
  featureSpec  Json
  notes        String?
  trainedAt    DateTime @default(now())

  @@index([target, active])
}
